/* 左侧面板样式 */
#left_widget {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #2c3e50,
        stop: 1 #34495e
    );
    border-top-left-radius: 15px;
    border-bottom-left-radius: 15px;
    border: none;
}

/* 云处理界面样式 - 半透明 */
#cloud_widget {
    /* 背景图（可选） */
    /* background-image: url(:/src/mqtt_beijing.png); */
    background-repeat: no-repeat;
    background-position: center;

    /* 半透明背景色 */
    background-color: rgba(80, 200, 120, 140);  /* A=140 表示半透明 */

    /* 边框样式 */
    border: 2px solid rgba(60, 42, 48, 180);    /* 半透明边框 */
    border-radius: 20px;                         /* 圆角 */

    /* 内边距 */
    padding: 10px;
}


/* ================= statusBtn ================= */
/* 默认状态：背景和面板一致，显示文字 */
#statusBtn {
    border: none;
    border-radius: 12px;
    min-width: 95px; max-width: 95px;
    min-height: 50px; max-height: 50px;
    background-color: #2c3e50;   /* 与面板一致 */
    color: white;                 /* 文字颜色 */
    font-size: 16px;
    font-weight: 600;
    text-align: center;
    line-height: 50px;            /* 垂直居中 */
}

/* 按下或选中状态：显示图片 */
#statusBtn:checked,
#statusBtn:pressed {
    border-image: url(:/src/status_pressed.png) 0 0 0 0 stretch stretch;
    background-color: none;       /* 图片覆盖背景 */
    color: transparent;           /* 隐藏文字 */
}

/* ================= mqttBtn ================= */
#mqttBtn {
    border: none;
    border-radius: 12px;
    min-width: 95px; max-width: 95px;
    min-height: 50px; max-height: 50px;
    background-color: #2c3e50;
    color: white;
    font-size: 16px;
    font-weight: 600;
    text-align: center;
    line-height: 50px;
}

#mqttBtn:checked,
#mqttBtn:pressed {
    border-image: url(:/src/cloud_pressed.png) 0 0 0 0 stretch stretch;
    background-color: none;
    color: transparent;
}

/* ================= uartBtn ================= */
#uartBtn {
    border: none;
    border-radius: 12px;
    min-width: 95px; max-width: 95px;
    min-height: 50px; max-height: 50px;
    background-color: #2c3e50;
    color: white;
    font-size: 16px;
    font-weight: 600;
    text-align: center;
    line-height: 50px;
}

#uartBtn:checked,
#uartBtn:pressed {
    border-image: url(:/src/uart_pressed.png) 0 0 0 0 stretch stretch;
    background-color: none;
    color: transparent;
}




/* ================= Connect Widget ================= */
#connectWidget {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #C8E6C9,   /* 上面亮绿色 */
        stop: 1 #C8E6C9    /* 下面深绿色 */
    );
    border-radius: 12px;
    border: 1px solid #1e8449;
}

/* ================= Login Widget ================= */
#loginWidget {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #3498db,   /* 上面亮蓝色 */
        stop: 1 #2980b9    /* 下面深蓝色 */
    );
    border-radius: 12px;
    border: 1px solid #1f618d;
}

/* ================= Message Widget ================= */
#messageWidget {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #f39c12,   /* 上面橙色 */
        stop: 1 #d35400    /* 下面深橙 */
    );
    border-radius: 12px;
    border: 1px solid #a84300;
}

/* ================= Subscribe Widget ================= */
#SubWidget {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #9b59b6,   /* 上面紫色 */
        stop: 1 #8e44ad    /* 下面深紫 */
    );
    border-radius: 12px;
    border: 1px solid #6c3483;
}

/* ================= Publish Widget ================= */
#PubWidget {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #e74c3c,   /* 上面亮红 */
        stop: 1 #c0392b    /* 下面深红 */
    );
    border-radius: 12px;
    border: 1px solid #922b21;
}

#LabelBroker, #LabelPort, #LabelClientID, #LabelUserName, #LabelPassword, #LabelPub, #LabelSub  {
    color: #ffffff;                   /* 白色字体，更醒目 */
    font-family: "Segoe UI", "Microsoft YaHei", "Arial", sans-serif; /* 现代、清晰字体 */
    font-size: 18px;                  /* 字号加大 */
    font-weight: 700;                 /* 加粗 */
    qproperty-alignment: AlignCenter; /* 居中对齐 */
}

#mqttStatusLabel{
    color: #000000;                   /* 白色字体，更醒目 */
    font-family: "Segoe UI", "Microsoft YaHei", "Arial", sans-serif; /* 现代、清晰字体 */
    font-size: 18px;                  /* 字号加大 */
    font-weight: 700;                 /* 加粗 */
    qproperty-alignment: AlignCenter; /* 居中对齐 */
}



/* connectMqtt 默认状态：未连接 */
#connectMqtt {
    background-color: #f44336; /* 红色 */
    color: #000000;            /* 黑色文字 */
    border-radius: 10px;
    font-size: 16px;
    min-width: 100px;    max-width: 100px;
    min-height: 40px;    max-height: 40px;
}

/* connectMqtt 被按下或 checkable 被选中：已连接 */
#connectMqtt:checked {
    background-color: #4CAF50; /* 绿色 */
    color: white;
}

/* 鼠标按下时 */
#connectMqtt:pressed {
    background-color: #da190b; /* 深红色，未连接状态按下 */
}

#connectMqtt:checked:pressed {
    background-color: #45A049; /* 深绿色，已连接状态按下 */
}


/* 控制面板底色 - 半透明渐变 */
#controlWidget {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 rgba(52, 73, 94, 180),   /* 上方半透明 */
        stop: 1 rgba(44, 62, 80, 180)    /* 下方半透明 */
    );
    border-radius: 16px;
    border: 2px solid rgba(26, 37, 47, 180);  /* 半透明边框 */
    padding: 12px;
}

#led_label, #alram_label, #fan_label {
    color: #ffffff;                   /* 白色字体，更醒目 */
    font-family: "Segoe UI", "Microsoft YaHei", "Arial", sans-serif; /* 现代、清晰字体 */
    font-size: 18px;                  /* 字号加大 */
    font-weight: 700;                 /* 加粗 */
    qproperty-alignment: AlignCenter; /* 居中对齐 */
}

/* ================= LED 按钮 ================= */
#ledBtn {
    border: none;
    background: transparent;
    padding: 0;
    margin: 0;
    min-width: 200px;
    min-height: 160px;
    max-width: 200px;
    max-height: 160px;
    qproperty-iconSize: 200px 160px;
    qproperty-icon: url(:/src/light_off.png); /* 默认图片 */
}
#ledBtn:checked {
    qproperty-icon: url(:/src/light_on.png);  /* 点击保持状态显示图片 */
}
#ledBtn:hover {
    background-color: rgba(255,255,255,0.1);
    border-radius: 12px;
}

/* ================= FAN 按钮 ================= */
#fanBtn {
    border: none;
    background: transparent;
    padding: 0;
    margin: 0;
    min-width: 200px;
    min-height: 160px;
    max-width: 200px;
    max-height: 160px;
    qproperty-iconSize: 200px 160px;
    qproperty-icon: url(:/src/fan_off.png);
}
#fanBtn:checked {
    qproperty-icon: url(:/src/fan_on.png);
}
#fanBtn:hover {
    background-color: rgba(255,255,255,0.1);
    border-radius: 12px;
}

/* ================= ALARM 按钮 ================= */
#alarmBtn {
    border: none;
    background: transparent;
    padding: 0;
    margin: 0;
    min-width: 200px;
    min-height: 160px;
    max-width: 200px;
    max-height: 160px;
    qproperty-iconSize: 200px 160px;
    qproperty-icon: url(:/src/alarm_off.png);
}
#alarmBtn:checked {
    qproperty-iconSize: 200px 160px;
    qproperty-icon: url(:/src/alarm_on.png);
}
#alarmBtn:hover {
    background-color: rgba(255,255,255,0.1);
    border-radius: 12px;
}


/*UART*/
#UartWidget {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 #c8c6f0,   /* 柔和的淡紫灰 */
        stop: 1 #dbe9f4    /* 浅蓝灰 */
    );
    border-radius: 12px;
    border: 1px solid #a6a6a6;  /* 比之前稍微深一点的灰边框 */
}

/* ================= ComboBox 通用样式 ================= */
QComboBox {
    background-color: #f7f7fb;            /* 背景浅灰紫，柔和 */
    border: 1px solid #b0b0c8;            /* 边框浅灰紫 */
    border-radius: 6px;                   /* 圆角 */
    padding: 4px 8px;                     /* 内边距，增加视觉空间 */
    font-size: 14px;                      /* 字体大小 */
    color: #333;                          /* 字体深灰 */
    min-width: 120px;                     /* 最小宽度，保证一致 */
}

/* 鼠标悬停时 */
QComboBox:hover {
    border: 1px solid #7a6ea5;            /* 紫色边框高亮 */
    background-color: #f0f0fa;            /* 背景稍微亮一点 */
}

/* 下拉箭头 */
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left: 1px solid #b0b0c8;       /* 左边分割线 */
    background-color: #e8e8f5;            /* 箭头区域背景 */
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
}

/* 箭头图标 */
QComboBox::down-arrow {
    image: url(:/src/down.png);     /* 你可以换成自己的小箭头 */
    width: 24px;
    height: 24px;
}

/* ================= 下拉列表 ================= */
QComboBox QAbstractItemView {
    border: 1px solid #b0b0c8;
    background-color: #ffffff;            /* 下拉列表背景 */
    selection-background-color: #cfc7f8;  /* 选中项背景 */
    selection-color: #000000;             /* 选中项文字 */
    outline: 0px;                         /* 去掉虚线框 */
}

#openSerialBtn {
    background-color: #3a3f5c;       /* 按钮底色 */
    color: #ffffff;                  /* 字体颜色 */
    border-radius: 12px;             /* 圆角 */

    /* 固定大小 */
    min-width: 160px;
    max-width: 160px;
    min-height: 40px;
    max-height: 40px;

    font-size: 16px;                 /* 字体大小，可根据需求调 */
    font-weight: bold;                /* 加粗字体 */
}

/* 按钮按下或选中状态 */
#openSerialBtn:checked {
    background-color: #7c83c0;       /* 按下/选中状态颜色 */
}
#openSerialBtn:hover {
    background-color: #5a5f7c;       /* 鼠标悬停状态颜色 */
}
