/* ===========================
 * StackedWidget 容器样式
 * =========================== */
 QStackedWidget {
    background: transparent; /* 透明背景，显示底层渐变 */
    border: none;
}

/* ===========================
 * 左侧面板样式
 * =========================== */
#left_widget {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1, /* 从上到下渐变 */
        stop: 0 #3498db,             /* 上方亮蓝色 - 更醒目的操作色 */
        stop: 1 #2980b9              /* 下方深蓝色 - 专业感 */
    );
    border-top-left-radius: 15px;    /* 左上圆角 */
    border-bottom-left-radius: 15px; /* 左下圆角 */
    border-top-right-radius: 15px;   /* 右上圆角 */
    border-bottom-right-radius: 15px; /* 右下圆角 */
    border: 2px solid #1f618d;       /* 添加边框增强层次感 */
    padding: 10px;                   /* 增加内边距 */
}

/* ===========================
 * 通用按钮基础样式（默认文字）
 * =========================== */
#statusBtn, #mqttBtn, #uartBtn, #musicBtn, #photoBtn {
    border: none;
    border-radius: 12px;
    min-width: 95px;
    max-width: 95px;
    min-height: 50px;
    max-height: 50px;
    background-color: rgb(22, 140, 53);  /* 默认绿色背景 */
    color: white;                        /* 默认文字颜色 */
    font-size: 16px;
    font-weight: 600;
    text-align: center;
    line-height: 50px;                   /* 垂直居中文字 */
    background-repeat: no-repeat;
    background-position: center;
    background-size: contain;
}

/* ===========================
 * 按下/选中状态（显示图片，隐藏文字）
 * =========================== */
#statusBtn:checked, #statusBtn:pressed {
    border-image: url(:/src/smart.png) 0 0 0 0 stretch stretch;
    background-color: transparent;   /* 背景用图覆盖 */
    color: transparent;              /* 隐藏文字 */
}

#mqttBtn:checked, #mqttBtn:pressed {
    border-image: url(:/src/smart.png) 0 0 0 0 stretch stretch;
    background-color: transparent;
    color: transparent;
}

#uartBtn:checked, #uartBtn:pressed {
    border-image: url(:/src/smart.png) 0 0 0 0 stretch stretch;
    background-color: transparent;
    color: transparent;
}

#musicBtn:checked, #musicBtn:pressed {
    border-image: url(:/src/music.png) 0 0 0 0 stretch stretch;
    background-color: transparent;
    color: transparent;
}

#photoBtn:checked, #photoBtn:pressed {
    border-image: url(:/src/photo.png) 0 0 0 0 stretch stretch;
    background-color: transparent;
    color: transparent;
}


/* ===========================
 * StackedWidget 页面样式
 * =========================== */

/* ===========================
 * 第一页：Idle 页面
 * =========================== */
#page_idle {
    border-radius: 15px;               /* 圆角半径 */
    border: 2px solid #3498db;         /* 边框颜色 */
    padding: 10px;                      /* 内边距 */
    background-color: #f0f8ff;          /* 浅蓝色，冷静感 */
}

/* ===========================
 * 第2页：smart 页面
 * =========================== */
#smart_mqtt_page {
    border-radius: 15px;               /* 圆角半径 */
    border: 2px solid #3498db;         /* 边框颜色 */
    padding: 10px;                      /* 内边距 */
    background-color: #f5f5f5;          /* 浅灰色，中性色，突出图片 */
}

/* ===========================
 * 第3页：Music 页面
 * =========================== */
#music_page {
    border-radius: 15px;               /* 圆角半径 */
    border: 2px solid #3498db;         /* 边框颜色 */
    padding: 10px;                      /* 内边距 */
    background-color: #fff0f5;          /* 浅粉色，音乐活跃感 */
}

/* ===========================
 * 第4页：Photo 页面
 * =========================== */
#photo_book_page {
    border-radius: 15px;               /* 圆角半径 */
    border: 2px solid #3498db;         /* 边框颜色 */
    padding: 10px;                      /* 内边距 */
    background-color: #f5f5f5;          /* 浅灰色，中性色，突出图片 */
}



/* ===========================
 * 云处理界面样式 - 半透明
 * =========================== */
#cloudWidget {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1, /* 从上到下渐变 */
        stop: 0 rgb(126, 154, 215),             /* 上方亮蓝色 - 更醒目的操作色 */
        stop: 1 rgb(52, 19, 215)              /* 下方深蓝色 - 专业感 */
    );
    border-top-left-radius: 15px;    /* 左上圆角 */
    border-bottom-left-radius: 15px; /* 左下圆角 */
    border-top-right-radius: 15px;   /* 右上圆角 */
    border-bottom-right-radius: 15px; /* 右下圆角 */
    border: 2px solid #1f618d;       /* 添加边框增强层次感 */
    padding: 10px;                   /* 增加内边距 */
}
/* ===========================
 * 连接 Widget 样式
 * =========================== */
#statuswidget {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1, /* 从上到下渐变 */
        stop: 0 #C8E6C9,             /* 上亮绿色 */
        stop: 1 #C8E6C9              /* 下深绿色 */
    );
    border-radius: 12px;            /* 圆角 */
    border: 1px solid #1e8449;      /* 边框颜色 */
}

/* ===========================
 * 登录 Widget 样式
 * =========================== */
#loginwidget {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #3498db, /* 上亮蓝色 */
        stop: 1 #2980b9  /* 下深蓝色 */
    );
    border-radius: 12px;
    border: 1px solid #1f618d;
}

/* ===========================
 * 消息 Widget 样式
 * =========================== */
#messagewidget {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #f39c12, /* 上橙色 */
        stop: 1 #d35400  /* 下深橙 */
    );
    border-radius: 12px;
    border: 1px solid #a84300;
}

/* ===========================
 * 订阅 Widget 样式
 * =========================== */
#subwidget {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #9b59b6, /* 上紫色 */
        stop: 1 #8e44ad  /* 下深紫 */
    );
    border-radius: 12px;
    border: 1px solid #6c3483;
}

/* ===========================
 * 发布 Widget 样式
 * =========================== */
#pubwidget {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #e74c3c, /* 上亮红 */
        stop: 1 #c0392b  /* 下深红 */
    );
    border-radius: 12px;
    border: 1px solid #922b21;
}

/* ===========================
 * 标签字体统一样式
 * =========================== */
#label_broker, #label_port, #LabelClientID, #label_username, #label_password, #label_Pub, #label_Sub, #connectlabel {
    color: #ffffff;                   /* 白色字体 */
    font-family: "Segoe UI", "Microsoft YaHei", "Arial", sans-serif; /* 清晰字体 */
    font-size: 18px;                  /* 字号 */
    font-weight: 700;                 /* 加粗 */
    qproperty-alignment: AlignCenter; /* 居中对齐 */
}

#mqttStatusLabel {
    color: #000000;
    font-family: "Segoe UI", "Microsoft YaHei", "Arial", sans-serif;
    font-size: 18px;
    font-weight: 700;
    qproperty-alignment: AlignCenter;
}

/* ===========================
 * 连接 MQTT 按钮默认/按下/选中样式
 * =========================== */
#connectMqttButton, #clearMsgBtn {
    background-color: #e56767; /* 默认红色 - 未连接 */
    color: #000000;            /* 黑色文字 */
    border-radius: 10px;
    font-size: 16px;
    min-width: 100px; max-width: 100px;
    min-height: 40px; max-height: 40px;
}

#clearMsgBtn {
    background-color: #23a97a; /* 默认红色 - 未连接 */
    color: #000000;            /* 黑色文字 */
    border-radius: 10px;
    font-size: 16px;
    min-width: 100px; max-width: 100px;
    min-height: 40px; max-height: 40px;
}

/* 订阅按钮 */
#subTopicBtn {
    background-color: #e56767;
    color: #000000;
    border-radius: 10px;
    font-size: 16px;
    min-width: 100px; max-width: 100px;
    min-height: 40px; max-height: 40px;
}

/* 选中 - 已连接状态 */
#connectMqttButton:checked, #clearMsgBtn:checked {
    background-color: #4CAF50; /* 绿色 */
    color: white;
}

/* 按下效果 */
#connectMqttButton:pressed, #clearMsgBtn:pressed {
    background-color: #da190b; /* 深红色 - 未连接状态按下 */
}

#connectMqttButton:checked:pressed, #clearMsgBtn:checked:pressed {
    background-color: #45A049; /* 深绿色 - 已连接状态按下 */
}

/* ===========================
 * 清除按钮样式
 * =========================== */
 #clearPubBtn, #clearSubBtn {
    background-color: #23a97a;
    color: #000000;
    border: none;
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 14px;
    font-weight: bold;
    box-shadow: 0px 2px 4px rgba(0,0,0,0.3); /* 投影制造边界感 */
}


/* 悬停效果 */
#clearPubBtn:hover, #clearSubBtn:hover{
    background-color: #e53935;   /* 悬停更深 */
}

/* 按下效果 */
#clearPubBtn:pressed, #clearSubBtn:pressed{
    background-color: #c62828;   /* 按下更深 */
}


/*subtopic lineedit 字体*/
#lineEdit_subtopic {
    border: 1px solid #CCCCCC;
    border-radius: 4px;
    padding: 2px 4px;
    background-color: #F0F0F0;
    font-size: 20px; /* 固定大小 */
}


/* ===========================
 * 控制面板底色 - 半透明渐变
 * =========================== */
#controlwidget {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 rgba(52, 73, 94, 180),   /* 上半透明 */
        stop: 1 rgba(44, 62, 80, 180)    /* 下半透明 */
    );
    border-radius: 16px;
    border: 2px solid rgba(26, 37, 47, 180);
    padding: 12px;
}

/* ===========================
 * 控制面板标签字体
 * =========================== */
#led_label, #alram_label, #fan_label {
    color: #ffffff;
    font-family: "Segoe UI", "Microsoft YaHei", "Arial", sans-serif;
    font-size: 18px;
    font-weight: 700;
    qproperty-alignment: AlignCenter;
}

#smartwidget {
    background-color: #0d1117;  /* 深色背景，衬托科技感 */
    border: 3px solid;
    border-radius: 12px;
    border-image: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1, /* 对角渐变 */
        stop: 0 #00e5ff,
        stop: 0.5 #7c4dff,
        stop: 1 #ff4081
    ) 1;   /* 渐变色做边框 */
}


/* ===========================
 * LED / FAN / ALARM 按钮
 * =========================== */
#ledBtn {
    border: none;
    background: transparent;
    padding: 0;
    margin: 0;
    min-width: 200px;
    min-height: 160px;
    max-width: 200px;
    max-height: 160px;
    qproperty-iconSize: 200px 160px;
    qproperty-icon: url(:/src/light_off.png);
}
#ledBtn:checked { qproperty-icon: url(:/src/light_on.png); }
#ledBtn:hover { background-color: rgba(255,255,255,0.1); border-radius: 12px; }

#fanBtn {
    border: none;
    background: transparent;
    padding: 0;
    margin: 0;
    min-width: 200px;
    min-height: 160px;
    max-width: 200px;
    max-height: 160px;
    qproperty-iconSize: 200px 160px;
    qproperty-icon: url(:/src/fan_off.png);
}
#fanBtn:checked { qproperty-icon: url(:/src/fan_on.png); }
#fanBtn:hover { background-color: rgba(255,255,255,0.1); border-radius: 12px; }

#alarmBtn {
    border: none;
    background: transparent;
    padding: 0;
    margin: 0;
    min-width: 200px;
    min-height: 160px;
    max-width: 200px;
    max-height: 160px;
    qproperty-iconSize: 200px 160px;
    qproperty-icon: url(:/src/alarm_off.png);
}
#alarmBtn:checked { qproperty-icon: url(:/src/alarm_on.png); }
#alarmBtn:hover { background-color: rgba(255,255,255,0.1); border-radius: 12px; }

/* ===========================
 * UART Widget 背景
 * =========================== */
#uartwidget {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 #c8c6f0, /* 柔和淡紫灰 */
        stop: 1 #dbe9f4  /* 浅蓝灰 */
    );
    border-radius: 12px;
    border: 1px solid #a6a6a6; /* 边框稍深灰 */
}

/* ===========================
 * QComboBox 样式
 * =========================== */
QComboBox {
    background-color: #f7f7fb;    /* 背景浅灰紫 */
    border: 1px solid #b0b0c8;    /* 边框浅灰紫 */
    border-radius: 6px;            /* 圆角 */
    padding: 4px 8px;              /* 内边距 */
    font-size: 14px;               /* 字号 */
    color: #333;                   /* 深灰文字 */
    min-width: 120px;              /* 最小宽度 */
}

QComboBox:hover {
    border: 1px solid #7a6ea5;    /* 悬停边框紫色 */
    background-color: #f0f0fa;    /* 背景稍亮 */
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left: 1px solid #b0b0c8; /* 分割线 */
    background-color: #e8e8f5;       /* 箭头区域背景 */
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
}

QComboBox::down-arrow {
    image: url(:/src/down.png);  /* 箭头图标 */
    width: 24px;
    height: 24px;
}

QComboBox QAbstractItemView {
    border: 1px solid #b0b0c8;
    background-color: #ffffff;          /* 下拉列表背景 */
    selection-background-color: #cfc7f8;/* 选中项背景 */
    selection-color: #000000;           /* 选中项文字 */
    outline: 0px;                       /* 去掉虚线框 */
}

/* ===========================
 * 打开串口按钮样式
 * =========================== */
#openSerialBtn {
    background-color: #3a3f5c;  /* 默认按钮底色 */
    color: #ffffff;             /* 文字颜色 */
    border-radius: 12px;        /* 圆角 */
    min-width: 160px; max-width: 160px;
    min-height: 40px; max-height: 40px;
    font-size: 16px;
    font-weight: bold;
}

/* 未打开状态 - 绿色 */
#openSerialBtn:!checked { background-color: #4CAF50; }

/* 已打开状态 - 红色 */
#openSerialBtn:checked { background-color: #F44336; }
.serial-action-btn {
    color: #ffffff;
    border-radius: 10px;
    min-width: 110px; max-width: 110px;
    min-height: 32px; max-height: 32px;
    font-size: 13px;
    font-weight: 500;
    border: none;
    transition: all 0.2s ease;
}

#serial_sendBtn { background-color: #7986cb; }      /* 发送按钮 */
#serial_clearrevBtn { background-color: #4db6ac; }  /* 清除接收 */
#serial_clearsendBtn { background-color: #ffb74d; } /* 清除发送 */

/* 悬停效果 */
#serial_sendBtn:hover { background-color: #9fa8da; }
#serial_clearrevBtn:hover { background-color: #80cbc4; }
#serial_clearsendBtn:hover { background-color: #ffcc80; }

/* 按下效果 */
#serial_sendBtn:pressed { background-color: #5c6bc0; }
#serial_clearrevBtn:pressed { background-color: #26a69a; }
#serial_clearsendBtn:pressed { background-color: #ffa726; }

/* ===========================
 * QCheckBox 样式
 * =========================== */
#checkBox_uarttimesend {
    spacing: 5px;
    font-weight: bold;
}

/* 禁用状态 */
#checkBox_uarttimesend::indicator:disabled {
    background-color: #CCCCCC;
}

/* ===========================
 * QLineEdit 样式
 * =========================== */
#lineEdit_uarttime {
    border: 1px solid #CCCCCC;
    border-radius: 4px;
    padding: 2px 4px;
    background-color: #F0F0F0; /* 禁用时灰色 */
}

/* ===========================
 * QTextBrowser 样式
 * =========================== */
#textBrowser_rev {
    background-color: black;
    color: #00FF00;
    font-family: Consolas;
    font-size: 14px;
}

/* ===========================
 * StackedWidget 页面通用样式
 * =========================== */
QWidget#page_mqtt, QWidget#page_uart {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 rgba(255, 255, 255, 30),   /* 上半透明白 */
        stop: 1 rgba(240, 240, 240, 40)    /* 下半透明浅灰 */
    );
    border-top-right-radius: 15px;     /* 右上圆角 */
    border-bottom-right-radius: 15px;  /* 右下圆角 */
    border: none;
}

/* ===========================
 * 页面标题样式
 * =========================== */
.page-title {
    color: #2c3e50;
    font-family: "Segoe UI", "Microsoft YaHei", "Arial", sans-serif;
    font-size: 24px;
    font-weight: 700;
    qproperty-alignment: AlignCenter;
    padding: 10px;
    background: rgba(255, 255, 255, 0.7);
    border-radius: 8px;
    margin: 10px;
}



/*
MUSIC
*/

/* 顶部区域 */
/* ================= 顶部区域 ================= */
/* 顶部导航栏，渐变蓝 + 圆角下边 */
#widget_top {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #73C9FF,    /* 顶部蓝色 */
        stop: 1 #C6E7FF     /* 底部浅蓝 */
    );
    padding: 10px;
}

/* ================= 左下区域 ================= */
/* 功能区：浅绿色半透明 */
#widget_bottom_left {
    background-color: rgba(144, 238, 144, 0.85); /* 浅绿色半透明 */
    border: none;
    padding: 15px;
    color: rgb(30, 30, 30); /* 深色文字，以便在浅色背景上清晰可见 */
}

/* ================= 右下区域 ================= */
/* 播放区：经典浅灰色半透明 */
#widget_bottom_right {
    background-color: rgba(240, 240, 240, 0.9); /* 经典浅灰色半透明 */
    border: none;
    padding: 15px;
    color: rgb(30, 30, 30); /* 深色文字，与浅灰背景形成对比 */
}





/* ================= 统一阴影效果 ================= */
/* 可以增加轻微阴影，让区域更分明 */
#widget_bottom_left, #widget_bottom_right {
    /* QSS 不支持 box-shadow, 可用背景渐变模拟 */
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(255,255,255,0.95),
        stop:1 rgba(255,255,255,0.85)
    );
}


/* QGroupBox 基础样式 */
/* 🎵 我的音乐 - 浅绿色背景 */
#groupBox_wodeyinyue {
    border: none;
    margin: 0px;
    padding: 12px;
    margin-top: 12px;
    background-color: rgba(200, 255, 200, 0.7);  /* 浅绿色半透明 */
    border-radius: 10px;                         /* 圆角 */
}

/* 🌐 在线音乐 - 浅蓝色背景 */
#groupBox_zaixian {
    border: none;
    margin: 0px;
    padding: 12px;
    margin-top: 12px;
    background-color: rgba(200, 220, 255, 0.7);  /* 浅蓝色半透明 */
    border-radius: 10px;
}


/* 🎵 通用样式：下载、喜欢、最近播放、在线、电台、推荐 */
#toolButton_biaoti,
#toolButton_xiazai,
#toolButton_xihuan,
#toolButton_zuijinbofang,
#toolButton_yinyueguan,
#toolButton_diantai,
#toolButton_tuijian {
    font-size: 16px;
    color: rgb(31, 24, 24);
    border: none;
    background: transparent;
    padding-right: 10px;
    spacing: 200px;          /* 图标和文字间距 */
    text-align: left;       /* 文字靠左 */

    /* ⚡ 关键属性，保证图标显示 */
    qproperty-toolButtonStyle: ToolButtonTextBesideIcon;
    qproperty-iconSize: 24px 24px;
}

/* 🔹 悬停 hover 状态 */
#toolButton_xiazai:hover,
#toolButton_xihuan:hover,
#toolButton_zuijinbofang:hover,
#toolButton_yinyueguan:hover,
#toolButton_diantai:hover,
#toolButton_tuijian:hover {
    background-color: rgb(248, 70, 70);
    border-radius: 8px;
}

/* 🔹 按下 pressed / 选中 checked 状态 */
#toolButton_xiazai:checked,
#toolButton_xihuan:checked,
#toolButton_zuijinbofang:checked,
#toolButton_yinyueguan:checked,
#toolButton_diantai:checked,
#toolButton_tuijian:checked,
#toolButton_xiazai:pressed,
#toolButton_xihuan:pressed,
#toolButton_zuijinbofang:pressed,
#toolButton_yinyueguan:pressed,
#toolButton_diantai:pressed,
#toolButton_tuijian:pressed {
    background-color: rgb(248, 70, 70);
    border-radius: 8px;
    color: white;
}

/* 通用音乐按钮样式 */
QToolButton#toolButton_zuidahua,
QToolButton#toolButton_zuixiaohua,
QToolButton#toolButton_zhuangban,
QToolButton#toolButton_tuichu,
QToolButton#toolButton_shangyiqu,
QToolButton#toolButton_bofangzanting,
QToolButton#toolButton_xiayiqu,
QToolButton#toolButton_sound,
QToolButton#toolButton_mode,
QToolButton#toolButton_geci,
QToolButton#toolButton_add
{
    /* 使用固定尺寸 */
    width: 48px;
    height: 48px;
    /* 增大图标尺寸 */
    qproperty-iconSize: 35px;
    border: none;                      /* 无边框 */
    border-radius: 12px;               /* 圆角 */
    background-color: rgba(255,255,255,0.05); /* 默认浅透明背景 */
    padding: 5px 10px;                 /* 内边距 */
    font-weight: bold;
}

/* 悬停 hover 效果 */
QToolButton#toolButton_biaoti:hover,
QToolButton#toolButton_zuidahua:hover,
QToolButton#toolButton_zuixiaohua:hover,
QToolButton#toolButton_zhuangban:hover,
QToolButton#toolButton_tuichu:hover,
QToolButton#toolButton_shangyiqu:hover,
QToolButton#toolButton_bofangzanting:hover,
QToolButton#toolButton_xiayiqu:hover,
QToolButton#toolButton_sound:hover,
QToolButton#toolButton_mode:hover,
QToolButton#toolButton_geci:hover,
QToolButton#toolButton_add:hover
{
    background-color: rgba(72, 218, 213, 0.3); /* 浅蓝高亮 */
}

/* 按下 pressed / 选中 checked 状态 */
QToolButton#toolButton_biaoti:pressed,
QToolButton#toolButton_zuidahua:pressed,
QToolButton#toolButton_zuixiaohua:pressed,
QToolButton#toolButton_zhuangban:pressed,
QToolButton#toolButton_tuichu:pressed,
QToolButton#toolButton_shangyiqu:pressed,
QToolButton#toolButton_bofangzanting:pressed,
QToolButton#toolButton_xiayiqu:pressed,
QToolButton#toolButton_sound:pressed,
QToolButton#toolButton_mode:pressed,
QToolButton#toolButton_geci:pressed,
QToolButton#toolButton_add:pressed
{
    background-color: rgba(72, 218, 213, 0.6); /* 深蓝高亮 */
    color: white; /* 按下文字变白 */
}


/* ===== 歌曲播放进度条 - 水平 ===== */
#horizontalSlider_music {
    /* 基础设置 */
    background: transparent;
    height: 16px;
    margin: 0px;
    padding: 0px 8px;
}

/* 滑轨背景 */
#horizontalSlider_music::groove:horizontal {
    border: none;
    height: 6px;
    background: #e0e0e0;           /* 未播放部分底色 */
    border-radius: 3px;
}

/* 已播放部分 - 渐变效果 */
#horizontalSlider_music::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #FF6B6B,           /* 珊瑚红 */
        stop:0.5 #4ECDC4,         /* 青绿色 */
        stop:1 #45B7D1);          /* 天蓝色 */
    border-radius: 3px;
    border: none;
}

/* 滑块样式 */
#horizontalSlider_music::handle:horizontal {
    background: #ffffff;
    border: 3px solid #FF6B6B;     /* 与进度条同色边框 */
    width: 20px;
    height: 20px;
    border-radius: 10px;
    margin: -7px 0;                /* 居中对齐 */
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
}

/* 滑块悬停效果 */
#horizontalSlider_music::handle:horizontal:hover {
    background: #FF6B6B;
    border: 3px solid #ffffff;
    transform: scale(1.2);
}

/* 滑块按下效果 */
#horizontalSlider_music::handle:horizontal:pressed {
    background: #FF4757;
    border: 3px solid #ffffff;
    box-shadow: 0 3px 8px rgba(255, 107, 107, 0.5);
}

/* 进度条悬停时变粗 */
#horizontalSlider_music:hover::groove:horizontal {
    height: 8px;
    border-radius: 4px;
}

#horizontalSlider_music:hover::sub-page:horizontal {
    height: 8px;
    border-radius: 4px;
}

#horizontalSlider_music:hover::add-page:horizontal {
    height: 8px;
    border-radius: 4px;
}

#verticalSlider_musci::groove:vertical {
    width: 24px;
    border-radius: 6px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #004a99,
        stop:1 #0077c2);
}

#verticalSlider_musci::sub-page:vertical {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #c0e6ff,
        stop:1 #a0d4ff);
    border-radius: 6px;
}

#verticalSlider_musci::handle:vertical {
    width: 28px;            /* >= groove 宽度 */
    height: 28px;
    margin: 0 -14px;        /* -width/2 */
    border: none;
    background: transparent;
    image: url(:/src/music/huakuai.png);
}

#verticalSlider_musci::handle:vertical:hover {
    width: 28px;
    height: 28px;
    margin: 0 -14px;
    image: url(:/src/music/huakuai.png);
}

#verticalSlider_musci::handle:vertical:pressed {
    width: 28px;
    height: 28px;
    margin: 0 -14px;
    image: url(:/src/music/huakuai.png);
}



/* 打开本地音乐效果 */
QPushButton#openMusicBtn {
    /* 现代醒目设计 */
    background-color: #00cc66;         /* 更鲜艳的亮绿色 */
    border: none;
    border-radius: 25px;               /* 更大的圆角 */
    color: black;
    font-weight: 700;                  /* 更重的字重 */
    font-size: 16px;                   /* 更大的字体 */
    font-family: 'Microsoft YaHei', 'Segoe UI', sans-serif; /* 更好的字体 */

    /* 尺寸设置 */
    min-width: 120px;                  /* 最小宽度 */
    min-height: 50px;                  /* 更大的高度 */
    padding: 15px 30px;                /* 更大的内边距 */

    /* 文字阴影 */
    text-shadow: 0px 2px 3px rgba(0, 0, 0, 0.3);

    /* 按钮阴影 */
    box-shadow: 0px 5px 15px rgba(0, 204, 102, 0.4);

    /* 渐变背景效果 */
    background: qlineargradient(
        x1: 0, y1: 0,
        x2: 0, y2: 1,
        stop: 0 #00ff88,               /* 顶部更亮的绿色 */
        stop: 1 #00cc66                /* 底部深一点的绿色 */
    );

    /* 过渡动画 */
    transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

/* 悬停效果 - 更明显的亮绿色 */
QPushButton#openMusicBtn:hover {
    background: qlineargradient(
        x1: 0, y1: 0,
        x2: 0, y2: 1,
        stop: 0 #00ff99,
        stop: 1 #00dd77
    );
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(0, 255, 136, 0.5);
    font-size: 16px;
}

/* 按下效果 - 深绿色反馈 */
QPushButton#openMusicBtn:pressed {
    background: qlineargradient(
        x1: 0, y1: 0,
        x2: 0, y2: 1,
        stop: 0 #00bb55,
        stop: 1 #009944
    );
    transform: translateY(1px);
    box-shadow: 0 3px 10px rgba(0, 187, 85, 0.4);
    padding: 16px 29px 14px 31px;      /* 按下位移效果 */
}

/* 焦点效果 - 明显的发光边框 */
QPushButton#openMusicBtn:focus {
    outline: none;
    box-shadow: 0 0 0 4px rgba(0, 255, 136, 0.6),
                0 5px 15px rgba(0, 204, 102, 0.4);
}

/* 禁用状态 */
QPushButton#openMusicBtn:disabled {
    background: #888888;
    color: #cccccc;
    box-shadow: none;
    transform: none;
}


/*MUSIC*/
/* 上一个按钮 */
#lastphotoBtn {
    border: none;
    background: transparent;
    image: url(:/picture/last.png);
}


/* 下一个按钮 */
#nextphotoBtn {
    border: none;
    background: transparent;
    image: url(:/picture/next.png);
}


/* 退出按钮 */
#exitphotoBtn {
    border: none;
    background: transparent;
    min-width: 25px;
    min-height: 25px;
    max-width: 25px;
    max-height: 25px;
    image: url(:/picture/exit.png);
}
