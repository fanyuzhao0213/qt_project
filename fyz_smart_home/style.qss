/* ===========================
 * StackedWidget 容器样式
 * =========================== */
 QStackedWidget {
    background: transparent; /* 透明背景，显示底层渐变 */
    border: none;
}

/* ===========================
 * StackedWidget中的左侧面板样式
 * =========================== */
 #stackedWidget #left_widget {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1, /* 从上到下渐变 */
        stop: 0 #3498db,             /* 上方亮蓝色 - 更醒目的操作色 */
        stop: 1 #2980b9              /* 下方深蓝色 - 专业感 */
    );
    border-top-left-radius: 15px;    /* 左上圆角 */
    border-bottom-left-radius: 15px; /* 左下圆角 */
    border-top-right-radius: 15px;   /* 右上圆角 */
    border-bottom-right-radius: 15px; /* 右下圆角 */
    border: 2px solid #1f618d;       /* 添加边框增强层次感 */
    padding: 10px;                   /* 增加内边距 */
}

/* ===========================
 * 状态按钮样式
 * =========================== */
#statusBtn {
    border: none;              /* 无边框 */
    border-radius: 12px;       /* 圆角 */
    min-width: 95px; max-width: 95px;
    min-height: 50px; max-height: 50px;
    background-color: rgb(22, 140, 53); /* 背景色与面板一致 */
    color: white;               /* 文字颜色 */
    font-size: 16px;            /* 字号 */
    font-weight: 600;           /* 加粗 */
    text-align: center;         /* 水平居中 */
    line-height: 50px;          /* 垂直居中 */
}

/* 被按下或选中状态 */
#statusBtn:checked,
#statusBtn:pressed {
    border-image: url(:/src/status_pressed.png) 0 0 0 0 stretch stretch; /* 覆盖背景图 */
    background-color: none;    /* 背景由图片覆盖 */
    color: transparent;        /* 隐藏文字 */
}

/* ===========================
 * MQTT 按钮样式
 * =========================== */
#mqttBtn {
    border: none;
    border-radius: 12px;
    min-width: 95px; max-width: 95px;
    min-height: 50px; max-height: 50px;
    background-color: rgb(22, 140, 53);
    color: white;
    font-size: 16px;
    font-weight: 600;
    text-align: center;
    line-height: 50px;
}

/* 被按下或选中状态 */
#mqttBtn:checked,
#mqttBtn:pressed {
    border-image: url(:/src/cloud_pressed.png) 0 0 0 0 stretch stretch;
    background-color: none;
    color: transparent;
}

/* ===========================
 * UART 按钮样式
 * =========================== */
#uartBtn {
    border: none;
    border-radius: 12px;
    min-width: 95px; max-width: 95px;
    min-height: 50px; max-height: 50px;
    background-color: rgb(22, 140, 53);
    color: white;
    font-size: 16px;
    font-weight: 600;
    text-align: center;
    line-height: 50px;
}

/* 被按下或选中状态 */
#uartBtn:checked,
#uartBtn:pressed {
    border-image: url(:/src/uart_pressed.png) 0 0 0 0 stretch stretch;
    background-color: none;
    color: transparent;
}

/* ===========================
 * 云处理界面样式 - 半透明
 * =========================== */
#cloudWidget {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1, /* 从上到下渐变 */
        stop: 0 rgb(126, 154, 215),             /* 上方亮蓝色 - 更醒目的操作色 */
        stop: 1 rgb(52, 19, 215)              /* 下方深蓝色 - 专业感 */
    );
    border-top-left-radius: 15px;    /* 左上圆角 */
    border-bottom-left-radius: 15px; /* 左下圆角 */
    border-top-right-radius: 15px;   /* 右上圆角 */
    border-bottom-right-radius: 15px; /* 右下圆角 */
    border: 2px solid #1f618d;       /* 添加边框增强层次感 */
    padding: 10px;                   /* 增加内边距 */
}
/* ===========================
 * 连接 Widget 样式
 * =========================== */
#statuswidget {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1, /* 从上到下渐变 */
        stop: 0 #C8E6C9,             /* 上亮绿色 */
        stop: 1 #C8E6C9              /* 下深绿色 */
    );
    border-radius: 12px;            /* 圆角 */
    border: 1px solid #1e8449;      /* 边框颜色 */
}

/* ===========================
 * 登录 Widget 样式
 * =========================== */
#loginwidget {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #3498db, /* 上亮蓝色 */
        stop: 1 #2980b9  /* 下深蓝色 */
    );
    border-radius: 12px;
    border: 1px solid #1f618d;
}

/* ===========================
 * 消息 Widget 样式
 * =========================== */
#messagewidget {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #f39c12, /* 上橙色 */
        stop: 1 #d35400  /* 下深橙 */
    );
    border-radius: 12px;
    border: 1px solid #a84300;
}

/* ===========================
 * 订阅 Widget 样式
 * =========================== */
#subwidget {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #9b59b6, /* 上紫色 */
        stop: 1 #8e44ad  /* 下深紫 */
    );
    border-radius: 12px;
    border: 1px solid #6c3483;
}

/* ===========================
 * 发布 Widget 样式
 * =========================== */
#pubwidget {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #e74c3c, /* 上亮红 */
        stop: 1 #c0392b  /* 下深红 */
    );
    border-radius: 12px;
    border: 1px solid #922b21;
}

/* ===========================
 * 标签字体统一样式
 * =========================== */
#label_broker, #label_port, #LabelClientID, #label_username, #label_password, #label_Pub, #label_Sub, #connectlabel {
    color: #ffffff;                   /* 白色字体 */
    font-family: "Segoe UI", "Microsoft YaHei", "Arial", sans-serif; /* 清晰字体 */
    font-size: 18px;                  /* 字号 */
    font-weight: 700;                 /* 加粗 */
    qproperty-alignment: AlignCenter; /* 居中对齐 */
}

#mqttStatusLabel {
    color: #000000;
    font-family: "Segoe UI", "Microsoft YaHei", "Arial", sans-serif;
    font-size: 18px;
    font-weight: 700;
    qproperty-alignment: AlignCenter;
}

/* ===========================
 * 连接 MQTT 按钮默认/按下/选中样式
 * =========================== */
#connectMqttButton, #clearMsgBtn {
    background-color: #e56767; /* 默认红色 - 未连接 */
    color: #000000;            /* 黑色文字 */
    border-radius: 10px;
    font-size: 16px;
    min-width: 100px; max-width: 100px;
    min-height: 40px; max-height: 40px;
}

#clearMsgBtn {
    background-color: #23a97a; /* 默认红色 - 未连接 */
    color: #000000;            /* 黑色文字 */
    border-radius: 10px;
    font-size: 16px;
    min-width: 100px; max-width: 100px;
    min-height: 40px; max-height: 40px;
}

/* 订阅按钮 */
#subTopicBtn {
    background-color: #e56767;
    color: #000000;
    border-radius: 10px;
    font-size: 16px;
    min-width: 100px; max-width: 100px;
    min-height: 40px; max-height: 40px;
}

/* 选中 - 已连接状态 */
#connectMqttButton:checked, #clearMsgBtn:checked {
    background-color: #4CAF50; /* 绿色 */
    color: white;
}

/* 按下效果 */
#connectMqttButton:pressed, #clearMsgBtn:pressed {
    background-color: #da190b; /* 深红色 - 未连接状态按下 */
}

#connectMqttButton:checked:pressed, #clearMsgBtn:checked:pressed {
    background-color: #45A049; /* 深绿色 - 已连接状态按下 */
}

/* ===========================
 * 清除按钮样式
 * =========================== */
 #clearPubBtn, #clearSubBtn {
    background-color: #23a97a;
    color: #000000;
    border: none;
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 14px;
    font-weight: bold;
    box-shadow: 0px 2px 4px rgba(0,0,0,0.3); /* 投影制造边界感 */
}


/* 悬停效果 */
#clearPubBtn:hover, #clearSubBtn:hover{
    background-color: #e53935;   /* 悬停更深 */
}

/* 按下效果 */
#clearPubBtn:pressed, #clearSubBtn:pressed{
    background-color: #c62828;   /* 按下更深 */
}


/*subtopic lineedit 字体*/
#lineEdit_subtopic {
    border: 1px solid #CCCCCC;
    border-radius: 4px;
    padding: 2px 4px;
    background-color: #F0F0F0;
    font-size: 20px; /* 固定大小 */
}


/* ===========================
 * 控制面板底色 - 半透明渐变
 * =========================== */
#controlwidget {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 rgba(52, 73, 94, 180),   /* 上半透明 */
        stop: 1 rgba(44, 62, 80, 180)    /* 下半透明 */
    );
    border-radius: 16px;
    border: 2px solid rgba(26, 37, 47, 180);
    padding: 12px;
}

/* ===========================
 * 控制面板标签字体
 * =========================== */
#led_label, #alram_label, #fan_label {
    color: #ffffff;
    font-family: "Segoe UI", "Microsoft YaHei", "Arial", sans-serif;
    font-size: 18px;
    font-weight: 700;
    qproperty-alignment: AlignCenter;
}

#smartwidget {
    background-color: #0d1117;  /* 深色背景，衬托科技感 */
    border: 3px solid;
    border-radius: 12px;
    border-image: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1, /* 对角渐变 */
        stop: 0 #00e5ff,
        stop: 0.5 #7c4dff,
        stop: 1 #ff4081
    ) 1;   /* 渐变色做边框 */
}


/* ===========================
 * LED / FAN / ALARM 按钮
 * =========================== */
#ledBtn {
    border: none;
    background: transparent;
    padding: 0;
    margin: 0;
    min-width: 200px;
    min-height: 160px;
    max-width: 200px;
    max-height: 160px;
    qproperty-iconSize: 200px 160px;
    qproperty-icon: url(:/src/light_off.png);
}
#ledBtn:checked { qproperty-icon: url(:/src/light_on.png); }
#ledBtn:hover { background-color: rgba(255,255,255,0.1); border-radius: 12px; }

#fanBtn {
    border: none;
    background: transparent;
    padding: 0;
    margin: 0;
    min-width: 200px;
    min-height: 160px;
    max-width: 200px;
    max-height: 160px;
    qproperty-iconSize: 200px 160px;
    qproperty-icon: url(:/src/fan_off.png);
}
#fanBtn:checked { qproperty-icon: url(:/src/fan_on.png); }
#fanBtn:hover { background-color: rgba(255,255,255,0.1); border-radius: 12px; }

#alarmBtn {
    border: none;
    background: transparent;
    padding: 0;
    margin: 0;
    min-width: 200px;
    min-height: 160px;
    max-width: 200px;
    max-height: 160px;
    qproperty-iconSize: 200px 160px;
    qproperty-icon: url(:/src/alarm_off.png);
}
#alarmBtn:checked { qproperty-icon: url(:/src/alarm_on.png); }
#alarmBtn:hover { background-color: rgba(255,255,255,0.1); border-radius: 12px; }

/* ===========================
 * UART Widget 背景
 * =========================== */
#uartwidget {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 #c8c6f0, /* 柔和淡紫灰 */
        stop: 1 #dbe9f4  /* 浅蓝灰 */
    );
    border-radius: 12px;
    border: 1px solid #a6a6a6; /* 边框稍深灰 */
}

/* ===========================
 * QComboBox 样式
 * =========================== */
QComboBox {
    background-color: #f7f7fb;    /* 背景浅灰紫 */
    border: 1px solid #b0b0c8;    /* 边框浅灰紫 */
    border-radius: 6px;            /* 圆角 */
    padding: 4px 8px;              /* 内边距 */
    font-size: 14px;               /* 字号 */
    color: #333;                   /* 深灰文字 */
    min-width: 120px;              /* 最小宽度 */
}

QComboBox:hover {
    border: 1px solid #7a6ea5;    /* 悬停边框紫色 */
    background-color: #f0f0fa;    /* 背景稍亮 */
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left: 1px solid #b0b0c8; /* 分割线 */
    background-color: #e8e8f5;       /* 箭头区域背景 */
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
}

QComboBox::down-arrow {
    image: url(:/src/down.png);  /* 箭头图标 */
    width: 24px;
    height: 24px;
}

QComboBox QAbstractItemView {
    border: 1px solid #b0b0c8;
    background-color: #ffffff;          /* 下拉列表背景 */
    selection-background-color: #cfc7f8;/* 选中项背景 */
    selection-color: #000000;           /* 选中项文字 */
    outline: 0px;                       /* 去掉虚线框 */
}

/* ===========================
 * 打开串口按钮样式
 * =========================== */
#openSerialBtn {
    background-color: #3a3f5c;  /* 默认按钮底色 */
    color: #ffffff;             /* 文字颜色 */
    border-radius: 12px;        /* 圆角 */
    min-width: 160px; max-width: 160px;
    min-height: 40px; max-height: 40px;
    font-size: 16px;
    font-weight: bold;
}

/* 未打开状态 - 绿色 */
#openSerialBtn:!checked { background-color: #4CAF50; }

/* 已打开状态 - 红色 */
#openSerialBtn:checked { background-color: #F44336; }
.serial-action-btn {
    color: #ffffff;
    border-radius: 10px;
    min-width: 110px; max-width: 110px;
    min-height: 32px; max-height: 32px;
    font-size: 13px;
    font-weight: 500;
    border: none;
    transition: all 0.2s ease;
}

#serial_sendBtn { background-color: #7986cb; }      /* 发送按钮 */
#serial_clearrevBtn { background-color: #4db6ac; }  /* 清除接收 */
#serial_clearsendBtn { background-color: #ffb74d; } /* 清除发送 */

/* 悬停效果 */
#serial_sendBtn:hover { background-color: #9fa8da; }
#serial_clearrevBtn:hover { background-color: #80cbc4; }
#serial_clearsendBtn:hover { background-color: #ffcc80; }

/* 按下效果 */
#serial_sendBtn:pressed { background-color: #5c6bc0; }
#serial_clearrevBtn:pressed { background-color: #26a69a; }
#serial_clearsendBtn:pressed { background-color: #ffa726; }

/* ===========================
 * QCheckBox 样式
 * =========================== */
#checkBox_uarttimesend {
    spacing: 5px;
    font-weight: bold;
}

/* 禁用状态 */
#checkBox_uarttimesend::indicator:disabled {
    background-color: #CCCCCC;
}

/* ===========================
 * QLineEdit 样式
 * =========================== */
#lineEdit_uarttime {
    border: 1px solid #CCCCCC;
    border-radius: 4px;
    padding: 2px 4px;
    background-color: #F0F0F0; /* 禁用时灰色 */
}

/* ===========================
 * QTextBrowser 样式
 * =========================== */
#textBrowser_rev {
    background-color: black;
    color: #00FF00;
    font-family: Consolas;
    font-size: 14px;
}

/* ===========================
 * StackedWidget 页面通用样式
 * =========================== */
QWidget#page_mqtt, QWidget#page_uart {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 rgba(255, 255, 255, 30),   /* 上半透明白 */
        stop: 1 rgba(240, 240, 240, 40)    /* 下半透明浅灰 */
    );
    border-top-right-radius: 15px;     /* 右上圆角 */
    border-bottom-right-radius: 15px;  /* 右下圆角 */
    border: none;
}

/* ===========================
 * 页面标题样式
 * =========================== */
.page-title {
    color: #2c3e50;
    font-family: "Segoe UI", "Microsoft YaHei", "Arial", sans-serif;
    font-size: 24px;
    font-weight: 700;
    qproperty-alignment: AlignCenter;
    padding: 10px;
    background: rgba(255, 255, 255, 0.7);
    border-radius: 8px;
    margin: 10px;
}
