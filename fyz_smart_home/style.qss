/* ================= ALARM 按钮 ================= */
#alarmBtn {
    border: none;
    background: transparent;
    padding: 0;
    margin: 0;
    min-width: 200px;
    min-height: 160px;
    max-width: 200px;
    max-height: 160px;
    qproperty-iconSize: 200px 160px;
    qproperty-icon: url(:/src/alarm_off.png);
}
#alarmBtn:checked {
    qproperty-iconSize: 200px 160px;
    qproperty-icon: url(:/src/alarm_on.png);
